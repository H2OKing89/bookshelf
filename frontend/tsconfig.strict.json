{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "./typings/*.d.ts",
    "./src/Activity/History/historyPageQuery.ts",
    "./src/Activity/Queue/*.ts",
    "./src/App/queryClient.ts",
    "./src/Book/BookIdentity.ts",
    "./src/Book/WorkCoverage/recordingWorkQuery.ts",
    "./src/InteractiveSearch/releaseSearchQuery.ts",
    "./src/InteractiveSearch/releaseWindow.ts",
    "./src/Author/Details/RecordingCatalogLabel.tsx",
    "./src/Settings/DownloadClients/Options/downloadClientOptionsState.ts",
    "./src/Utilities/Book/recordingIdentity.ts",
    "./src/Utilities/Fetch/**/*.ts",
    "./src/System/Status/MetadataProviders/**/*.ts",
    "./src/System/Status/MetadataProviders/**/*.tsx",
    "./src/Wanted/**/*.ts",
    "./src/Wanted/**/*.tsx",
    "./test/types/**/*.ts"
  ]
}
