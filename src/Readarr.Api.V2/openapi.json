          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DownloadQueueTarget"
            },
            "nullable": true
          },
          "removeFromClient": {
            "type": "boolean"
          },
          "changeCategory": {
            "type": "boolean"
          },
          "blocklist": {
            "type": "boolean"
          },
          "skipRedownload": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
