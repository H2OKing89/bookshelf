          "sizeleft": {
            "type": "number",
            "format": "double"
          },
          "timeleft": {
            "type": "string",
            "format": "date-span",
            "nullable": true
          },
          "estimatedCompletionTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "trackedDownloadStatus": {
            "$ref": "#/components/schemas/TrackedDownloadStatus"
          },
          "trackedDownloadState": {
            "$ref": "#/components/schemas/TrackedDownloadState"
          },
          "statusMessages": {
            "type": "array",
