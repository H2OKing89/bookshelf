          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "downloadId": {
            "type": "string",
            "nullable": true
          },
          "downloadClientId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "downloadClientAvailable": {
            "type": "boolean",
            "nullable": true
          },
          "protocol": {
            "$ref": "#/components/schemas/DownloadProtocol"
          },
          "downloadClient": {
            "type": "string",
            "nullable": true
          },
          "indexer": {
            "type": "string",
            "nullable": true
          },
          "outputPath": {
            "type": "string",
            "nullable": true
          },
          "downloadForced": {
            "type": "boolean"
          }
