          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DownloadQueueTarget"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DownloadQueueAuthor": {
        "type": "object",
