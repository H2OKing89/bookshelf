    "securitySchemes": {
      "X-Api-Key": {
        "type": "apiKey",
        "description": "API key supplied as header",
        "name": "X-Api-Key",
        "in": "header"
      },
      "apikey": {
        "type": "apiKey",
        "description": "API key supplied as query",
        "name": "apikey",
        "in": "query"
      },
      "BearerApiKey": {
        "type": "http",
        "description": "API key supplied as a Bearer token",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
