          },
          "includeCustomFormatWhenRenaming": {
            "type": "boolean",
            "nullable": true
          },
          "specifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomFormatSpecificationSchema"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CustomFormatSpecificationSchema": {
        "type": "object",
