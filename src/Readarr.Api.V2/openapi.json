            "nullable": true
          },
          "author": {
            "$ref": "#/components/schemas/DownloadQueueAuthor"
          },
          "canRemove": {
            "type": "boolean"
          },
          "canRemoveFromClient": {
            "type": "boolean"
          },
          "canChangeCategory": {
            "type": "boolean"
          },
          "canIgnore": {
            "type": "boolean"
          },
          "canBlocklist": {
            "type": "boolean"
          },
          "canRetry": {
            "type": "boolean"
          },
          "canGrab": {
            "type": "boolean"
          },
          "canImport": {
            "type": "boolean"
          },
          "quality": {
            "$ref": "#/components/schemas/QualityModel"
          },
          "customFormats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomFormatResource"
            },
            "nullable": true
          },
          "customFormatScore": {
            "type": "integer",
            "format": "int32"
